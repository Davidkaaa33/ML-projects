FROM node:22-alpine AS web-build

WORKDIR /web
COPY apps/web/package.json ./
RUN npm install --no-audit --no-fund
COPY apps/web ./
RUN cat \
      cv-pdf/pdf01.b64 \
      cv-pdf/p08000.b64 \
      cv-pdf/p24000.b64 \
      cv-pdf/p32000.b64 \
      cv-pdf/p40000.b64 \
      cv-pdf/p48000.b64 \
      cv-pdf/p56000.b64 \
      cv-pdf/p64000.b64 \
      cv-pdf/p72000.b64 \
    | base64 -d > public/David_Danielian_CV.pdf \
    && echo "9f8ec1e5114d8cb772b04f6c82793606e70c3c16a4c6e51271c3bde06b4f8dc4  public/David_Danielian_CV.pdf" | sha256sum -c - \
    && npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/apps/api

WORKDIR /workspace

COPY apps/api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY apps/api ./apps/api
COPY bank-transaction-fraud-detection ./bank-transaction-fraud-detection
COPY credit-repayment-prediction ./credit-repayment-prediction
COPY spam-detector ./spam-detector
COPY T9-typo-correction ./T9-typo-correction
COPY llm-knowledge-base-assistant/eval ./llm-knowledge-base-assistant/eval
COPY --from=web-build /web/dist ./apps/web/dist

USER 10001:10001

EXPOSE 8000

CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
